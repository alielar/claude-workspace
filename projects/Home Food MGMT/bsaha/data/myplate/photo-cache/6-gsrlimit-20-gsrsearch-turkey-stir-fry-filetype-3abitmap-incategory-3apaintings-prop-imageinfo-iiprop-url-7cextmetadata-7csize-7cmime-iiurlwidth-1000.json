oading": "lazy", "width": 1000, "height": 750}, "url": "https://upload.wikimedia.org/wikipedia/commons/3/3a/Kheema_%28spicy_mince%29_%281949040625%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Kheema_(spicy_mince)_(1949040625).jpg", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=87474986", "extmetadata": {"DateTime": {"value": "2020-02-26 13:33:55", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Kheema (spicy mince) (1949040625)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Flickr images reviewed by FlickreviewR 2|Cardamom-based food|Peas as garnish|Images from Indian Home cooking Flickr group uploaded by Netha Hussain", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "<p>This dish is popular in India thanks to the quaint cafes run by Iranian immigrants. It is served with bread to hundreds of hungry office goers.\n</p><p>Heat 3 tbsp oil and add 1 bay leaf + 4 cloves + 1\" cinnamon + 3 cardamom + 1\" chopped ginger and fry for 10 seconds. Add 1 chopped onion and fry on medium heat until onions are brown. Add 1/2 tsp turmeric powder + 1 tsp chili powder + 1 tsp garam masala (curry powder) + 1tsp corriander powder + 1 tsp cumin powder and mix. Add 4 tbsp tomato puree and mix. Add 500 gm minced meat (beef / lamb / turkey) and stir fry for 5 min. Add 1 chopped potato and salt to taste. Add water and cook until done. In the meantime, pour boiling water over fresh peas and let it stand for 5 min. Refresh with cold water.\n</p>\nServe the mince garnished with peas and corriander leaves.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2007-10-24 13:22", "source": "commons-desc-page"}, "Credit": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/rovingi/1949040625/\">Kheema (spicy mince)</a>", "source": "commons-desc-page"}, "Artist": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/70522326@N00\">rovingI</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY 2.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 2.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/2.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-2.0", "source": "commons-templates", "hidden": ""}}, "mime": "image/jpeg"}]}, "13352840": {"pageid": 13352840, "ns": 6, "title": "File:Pieter Brueghel the Elder - The Dutch Proverbs - Google Art Project.jpg", "index": 1, "imagerepository": "local", "imageinfo": [{"size": 18918563, "width": 5649, "height": 4000, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Pieter_Brueghel_the_Elder_-_The_Dutch_Proverbs_-_Google_Art_Project.jpg/1280px-Pieter_Brueghel_the_Elder_-_The_Dutch_Proverbs_-_Google_Art_Project.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1000, "thumbheight": 708, "responsiveUrls": {"2": "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Pieter_Brueghel_the_Elder_-_The_Dutch_Proverbs_-_Google_Art_Project.jpg/3840px-Pieter_Brueghel_the_Elder_-_The_Dutch_Proverbs_-_Google_Art_Project.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Pieter_Brueghel_the_Elder_-_The_Dutch_Proverbs_-_Google_Art_Project.jpg/1280px-Pi